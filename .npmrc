; Starting .npmrc for a new project. Copy to the project root as .npmrc
; (note the dot). npm reads it for every install in this folder.

; A release cooldown: npm will not install a package version published less
; than three days ago; it takes the newest one older than that. Poisoned
; releases in the 2025 and 2026 npm attacks were pulled within hours to a
; couple of days, so waiting three days almost never meets one. Needs npm
; 11.10 or later (the dev container pins npm 12); older npm ignores the line.
min-release-age=3

; A package needed the same day it ships is exempted by name, one per line:
; min-release-age-exclude[]=some-package
