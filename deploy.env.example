# Copy this file to deploy.env (which is git-ignored) and fill it in.
# deploy.sh reads these values.

# The droplet, as you would type it after "ssh ". The IP is used rather than
# the domain so SSH still works if Cloudflare is proxying the domain.
# (This repo is public, so the real address is not written here.)
DROPLET_HOST="<droplet ip>"
# The "deploy" account owns this site's folder and may restart its service
# through a limited sudo rule. Never root.
DROPLET_USER="deploy"

# Where the site lives on the droplet (PRD.md, Deployment section).
# The repository is checked out in the "repo" folder inside it.
SITE_ROOT="/var/www/circular.workshopper.ai"

# Checked at the end of a deploy and printed so you can tap it.
SITE_URL="https://circular.workshopper.ai"
